# Values consumed by docker-compose.yml.
#
# Copy to backend/.env and fill in. That file is gitignored; this one is not,
# so it must never hold a real credential.
#
# NOTE: the previous RabbitMQ credentials were committed in plaintext inside
# docker-compose.yml and are therefore in the git history for good. Rotate them
# on the broker — moving them here does not un-leak them.

RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
