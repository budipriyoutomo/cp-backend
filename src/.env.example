APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── DATABASE ────────────────────────────────────────────────────────────────
# PAKAI DATABASE LOKAL. Jangan pernah menunjuk .env developer ke server
# produksi: perintah seperti `migrate:fresh` menghapus seluruh tabel, dan
# tidak ada konfirmasi yang menyelamatkan kalau targetnya salah.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=maharasa_local
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── S3 (foto waste di closing report) ───────────────────────────────────────
# Tanpa ini unggah foto waste gagal, tapi sisa aplikasi tetap jalan.
# `AWS_ENDPOINT` dan `AWS_URL` hanya perlu untuk S3-compatible non-AWS
# (MinIO dan sejenisnya); kosongkan kalau memang memakai AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_URL=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── JWT (tymon/jwt-auth) ────────────────────────────────────────────────────
# WAJIB. Tanpa ini seluruh jalur auth mati — login, /auth/me, refresh, semuanya.
# Isi dengan `php artisan jwt:secret`. Jangan pakai nilai dari environment lain:
# token yang ditandatangani secret yang sama berlaku lintas environment.
JWT_SECRET=
# Umur access token, dalam menit. Nilai di bawah adalah default `config/jwt.php`
# — ditulis di sini supaya jadi keputusan yang terlihat, bukan default diam.
# Tablet dapur membuka PWA sepanjang shift, jadi 60 menit ini pasti terlewati;
# yang menjaga sesinya adalah `POST /auth/refresh`, lihat backend/CLAUDE.md.
JWT_TTL=60
# Batas sesi sebenarnya, dalam menit (20160 = 14 hari). Lewat ini refresh
# ditolak dan operator harus login ulang.
JWT_REFRESH_TTL=20160

# ── RABBITMQ (worker `rabbit:consume-posdata`) ──────────────────────────────
# Sumber angka POS. Tanpa ini worker tidak jalan dan "Get Data POS" kosong,
# tapi sisa aplikasi tetap hidup.
#
# PERINGATAN: nilai produksi lama pernah ter-commit di docker-compose.yml dan
# masih ada di riwayat git. Host, user, dan password harus dirotasi di broker —
# memindahkan file tidak menghapus apa pun dari histori.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── BOOTSTRAP (dipakai `php artisan db:seed --class=BootstrapSeeder`) ────────
# Brand: daftar CODE:Nama dipisah koma. `code` dipakai migrasi data brand.
BOOTSTRAP_BRANDS=
# Outlet: daftar CODE:Nama:Brand dipisah koma. `code` adalah kontrak dengan POS.
BOOTSTRAP_OUTLETS=
# Admin pertama. Tidak ada nilai default — seeder menolak jalan tanpa ini.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
